# Experimento de chunking: artefactos regenerables, uno por variante.
# Se versionan el código, los manifiestos, las tablas de resultados y la
# caché de consultas; nunca los fragmentos, los vectores ni el índice.
experimentos/chunking/*/chunks.jsonl
experimentos/chunking/*/chunks_meta.parquet
experimentos/chunking/*/*.npy
experimentos/chunking/*/*.faiss
